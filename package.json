{
  "name": "career-os",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun run scripts/build-workspaces.ts",
    "check": "bun run typecheck && bun test && bun run build && bun run verify:migrations && bun run verify:repository && bun run verify:workflows",
    "dev:api": "bun --cwd apps/api run dev",
    "dev:web": "bun --cwd apps/web run dev",
    "dev:worker": "bun --cwd apps/worker run dev",
    "local:down": "docker compose --profile local down",
    "local:setup": "bun run scripts/setup-local.ts",
    "local:smoke": "bun run scripts/smoke-local.ts",
    "local:up": "docker compose --profile local up --build",
    "pilot:apply": "bun run scripts/pilot-registry.ts apply --manifest private/pilot-registry.json --expected 1000",
    "pilot:verify": "bun run scripts/pilot-registry.ts verify --manifest private/pilot-registry.json --expected 1000",
    "pilot:verify-database": "bun run scripts/verify-pilot-registry.ts",
    "db:migrate": "bun run scripts/migrate.ts",
    "db:verify": "bun run scripts/verify-database.ts",
    "smoke:host": "bun run scripts/smoke-host.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "verify:migrations": "bun run scripts/verify-migrations.ts",
    "verify:repository": "bun run scripts/verify-repository.ts",
    "verify:workflows": "bun run scripts/verify-workflows.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "typescript": "7.0.2"
  }
}
