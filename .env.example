# Local-development defaults only. This file contains no deployed credentials.
CAREER_OS_PROFILE=local
NETWORK_BOUNDARY=loopback
LOCAL_ONLY=true
DISCOVERY_PUBLIC_BASE_URL=http://127.0.0.1:4100
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://127.0.0.1:4100
AUTH_MODE=local
TRANSPORT_SECURITY=none
CAREER_OS_LOCAL_API_TOKEN=
# Hosted trusted-proxy profiles must set exact proxy IPs; direct TLS profiles set certificate/key file paths.
# TRUSTED_PROXY_IPS=127.0.0.1
# TLS_CERT_FILE=/run/secrets/tls-cert.pem
# TLS_KEY_FILE=/run/secrets/tls-key.pem
POSTGRES_DB=career_os
POSTGRES_USER=career_os
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql://career_os:local-development-only@127.0.0.1:5432/career_os
ARTIFACT_ROOT=./artifacts
# Optional personless product analytics. Leave the key empty to disable all capture.
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
API_PORT=4100
WEB_PORT=3000
WORKER_HEALTH_PORT=4101
